# bon-vivant — Environment Variable Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in your real values. NEVER commit your .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic ────────────────────────────────────────────────────────────────
# Your Anthropic API key. Get one at: https://console.anthropic.com/
# The multi-model pipeline uses Sonnet (research), Haiku (dedup), and Opus (synthesis).
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Gemini API key for Google Search grounding (runs alongside Sonnet for research).
# Get one at: https://aistudio.google.com/app/apikey
# Set NEWSLETTER_PARALLEL=0 to disable the parallel pipeline and skip this requirement.
GEMINI_API_KEY=AIza...

# ── Gmail ─────────────────────────────────────────────────────────────────────
# The Gmail address that SENDS the newsletter (must have an App Password set up
# AND must be allowed to post to the target Google Group).
GMAIL_SENDER=youraddress@gmail.com

# The Google Group address that RECEIVES the newsletter. The newsletter is
# delivered by emailing this address; the Group must have email posting
# enabled and GMAIL_SENDER must be permitted to post (either as a member, or
# via the Group's "Who can post" permissions).
# Format: groupname@googlegroups.com  (or yourdomain.com for Workspace Groups)
GOOGLE_GROUP_EMAIL=your-group@googlegroups.com

# Gmail App Password — NOT your regular Gmail password.
# How to generate one:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Select app: "Mail", device: "Other" → name it "bon-vivant"
#   4. Copy the 16-character password (paste without spaces)
GMAIL_APP_PASSWORD=abcdefghijklmnop
